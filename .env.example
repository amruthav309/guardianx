# ===========================
# DATABASE CONFIGURATION
# ===========================

# Option A: Direct database URL (recommended for production)
# For SQLite (simple, no external DB): sqlite:///./guardianx.db
# For MySQL: mysql+pymysql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./guardianx.db

# Option B: MySQL component parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=guardianx
DB_USER=root
DB_PASSWORD=your_db_password_here


# ===========================
# EMAIL CONFIGURATION
# ===========================

EMAIL_ADDRESS=your_email@gmail.com
# Gmail App Password (not your real password) - generate at myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxxx_xxxx_xxxx_xxxx


# ===========================
# SECURITY
# ===========================

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_strong_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ===========================
# EMAIL VERIFICATION
# ===========================

OTP_EXPIRY=300


# ===========================
# APPLICATION
# ===========================

APP_NAME=GuardianX
APP_VERSION=1.0
DEBUG=False

# CORS - set to your Vercel frontend URL in production
FRONTEND_URL=https://your-app.vercel.app
